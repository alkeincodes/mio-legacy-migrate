# Single-quote any value containing #, $ or a space: LEGACY_DB_PASSWORD='p#ss w$rd'
# dotenv cuts an unquoted value at the first #, which reads as a wrong password.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
SSH_BOX_HOST=
SSH_BOX_USER=
SSH_KNOWN_HOSTS_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional separate principal for the V3 bucket. Must also hold s3:GetObject on the legacy
# bucket, because CopyObject runs under it. Empty means the legacy pair is used for both.
V3_AWS_ACCESS_KEY_ID=
V3_AWS_SECRET_ACCESS_KEY=
LEGACY_S3_BUCKET=
LEGACY_S3_URL=
LEGACY_CDN_URL=
V3_API_KEY_MANTALKS_PROD=
# Logins live in profiles/<name>.json (profile init --legacy-login/--verify-login/--platform-login).
# The six below are only the fallback for a profile that sets none.
LEGACY_HUB_LOGIN_EMAIL=
LEGACY_HUB_LOGIN_PASSWORD=
# A hub MEMBER of the target hub; verify logs into the hub with it (Playwright).
V3_VERIFY_LOGIN_EMAIL=
V3_VERIFY_LOGIN_PASSWORD=
# A platform (team) user; apply and verify call the API with it when no V3_API_KEY_<PROFILE> is set.
V3_PLATFORM_LOGIN_EMAIL=
V3_PLATFORM_LOGIN_PASSWORD=
V3_TEST_MEMBER_NOENT_TOKEN=
V3_TEST_MEMBER_ENTITLED_TOKEN=
