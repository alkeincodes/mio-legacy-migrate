# Single-quote any value containing #, $ or a space: LEGACY_DB_PASSWORD='p#ss w$rd'
# dotenv cuts an unquoted value at the first #, which reads as a wrong password.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
SSH_BOX_HOST=
SSH_BOX_USER=
SSH_KNOWN_HOSTS_FILE=
# Salt of searchie's hub.subdomain hashids connection (config/hashids.php). Only needed to
# resolve a default hub-<hash>.membership.io host; a custom domain or subdomain works without it.
LEGACY_HASHIDS_SALT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional separate principal for the V3 bucket. Must also hold s3:GetObject on the legacy
# bucket, because CopyObject runs under it. Empty means the legacy pair is used for both.
V3_AWS_ACCESS_KEY_ID=
V3_AWS_SECRET_ACCESS_KEY=
LEGACY_S3_BUCKET=
LEGACY_S3_URL=
LEGACY_CDN_URL=
V3_API_KEY_MANTALKS_PROD=
V3_TEST_MEMBER_NOENT_TOKEN=
V3_TEST_MEMBER_ENTITLED_TOKEN=
# The V3 target every hub shares. Per-hub values (team id, logins) live in profiles/<name>.json.
V3_API_BASE=https://api.member.dev
V3_ASSETS_BUCKET=mio-backend-assets-production
V3_ASSETS_REGION=us-east-1
V3_CDN_BASE=https://miocdn.membership.io
# false until someone confirms V3_CDN_BASE against a real V3 media URL; apply --check-access prints it.
V3_CDN_BASE_CONFIRMED=false
V3_HUB_BASE=https://hub.member.dev
