{
  "kind": "container",
  "template": "hero",
  "settings": {
    "maxWidth": "content",
    "padding": 0,
    "surface": {
      "background": {
        "type": "tint"
      },
      "padding": "section"
    }
  },
  "dataSource": {
    "id": "",
    "type": "file"
  },
  "repeat": {
    "limit": 1,
    "over": "dataSource"
  },
  "children": [
    {
      "kind": "row",
      "settings": {
        "gap": "section",
        "responsive": true,
        "split": true
      },
      "children": [
        {
          "kind": "media-slot",
          "settings": {
            "aspectRatio": "16:9",
            "name": "cover",
            "outline": true,
            "preset": "medium-720",
            "progressBar": true,
            "radius": "m"
          }
        },
        {
          "kind": "stack",
          "settings": {
            "align": "start",
            "gap": 2
          },
          "children": [
            {
              "kind": "field",
              "settings": {
                "name": "title",
                "role": "title",
                "size": "title",
                "weight": 700
              }
            },
            {
              "kind": "row",
              "settings": {
                "align": "center",
                "gap": 2.5
              },
              "children": [
                {
                  "kind": "field",
                  "settings": {
                    "name": "status",
                    "optional": true,
                    "ring": {
                      "size": 16,
                      "value": 100
                    },
                    "role": "meta",
                    "tone": "primary"
                  }
                },
                {
                  "kind": "field",
                  "settings": {
                    "icon": "clock",
                    "name": "duration",
                    "role": "meta"
                  }
                },
                {
                  "kind": "field",
                  "settings": {
                    "icon": "eye",
                    "name": "plays",
                    "optional": true,
                    "role": "meta"
                  }
                }
              ]
            },
            {
              "kind": "field",
              "settings": {
                "clamp": 5,
                "marginBottom": 4,
                "name": "description",
                "optional": true,
                "role": "body"
              }
            },
            {
              "kind": "button",
              "settings": {
                "actionFromScope": "action",
                "compactMobile": true,
                "icon": "play-filled"
              },
              "value": "Play"
            }
          ]
        }
      ]
    }
  ]
}
